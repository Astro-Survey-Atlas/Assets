artifacts/moc-source-probe-*.json
.tmp-screens
.tmp-ui
tmp/*
.opencode/
.assets-content/
.info
.assets-local/

# Private evidence families: durable copies live in object storage
# (content-archive evidence namespace); keep them out of git status.
artifacts/public-survey-footprints/raw/
artifacts/public-survey-footprints/layers/*/provenance.json
.artifacts-release-staging/

# Generated layer outputs: packaged into the immutable release archive
# (bundle sha256 in release-manifest.json); keep them out of git status.
artifacts/public-survey-footprints/layers/*/*.moc.fits
artifacts/public-survey-footprints/layers/*/preview-order*.json
artifacts/public-survey-footprints/layers/*/query-order*.json
artifacts/public-survey-footprints/layers/*/statistics.json
