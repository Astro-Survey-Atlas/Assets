{
  "name": "astro-survey-atlas-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:build": "tsx scripts/build-release-manifest.ts",
    "artifacts:validate": "tsx scripts/public_footprint_artifacts.ts validate",
    "preview:build": "tsx scripts/generate-coverage-preview.ts",
    "moc:validate": "tsx scripts/validate-moc-source-registry.ts",
    "moc:probe": "tsx scripts/validate-moc-source-registry.ts --probe --output=artifacts/moc-source-probe.json",
    "packages:rebuild": "PYTHONPATH=${MOC_CORE_ROOT:-../MOC-Core-SDK} SOURCE_DATE_EPOCH=1787184000 python3 scripts/rebuild_resource_packages.py && python3 scripts/update_provenance_hashes.py && npm run catalog:build",
    "core:wheel": "SOURCE_DATE_EPOCH=1787184000 python3 -m pip wheel --no-deps --no-build-isolation ${MOC_CORE_ROOT:-../MOC-Core-SDK} --wheel-dir artifacts/public-survey-footprints/moc-core",
    "core:rebuild-public": "PYTHONPATH=${MOC_CORE_ROOT:-../MOC-Core-SDK} SOURCE_DATE_EPOCH=1787184000 python3 -m astro_survey_moc_core.cli rebuild-public --base-dir .",
    "assets:build": "npm run artifacts:validate && npm run catalog:build && npm run preview:build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:site": "vite build",
    "build": "npm run assets:build && npm run build:server && npm run build:site",
    "dev": "tsx watch server/server.ts",
    "dev:site": "vite --host 0.0.0.0 --port 5174",
    "start": "node dist/server/server.js",
    "sync": "node dist/server/sync-release.js",
    "test:node": "tsx --test test/*.test.ts",
    "test:core": "python3 scripts/verify_core_wheel.py",
    "test": "npm run test:node && npm run test:core",
    "validate": "npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "healpixjs": "^2.0.0",
    "lucide": "^1.25.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.4",
    "pngjs": "^7.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  }
}
