{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
      },
      "required": ["type", "port"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany"] } },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
      },
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size"]
    },
    "contentPersistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany"] } },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
      },
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size"]
    },
    "admin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "warehouseNamespace": { "type": "string", "minLength": 1 },
        "localPathRoot": { "type": "string", "minLength": 1 },
        "adminTokenSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "key"]
        }
      },
      "required": ["enabled", "warehouseNamespace", "localPathRoot", "adminTokenSecret"]
    },
    "ingress": { "type": "object" },
    "resources": { "type": "object" },
    "syncResources": { "type": "object" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" }
  },
  "required": ["replicaCount", "image", "service", "persistence", "contentPersistence", "admin"]
}
