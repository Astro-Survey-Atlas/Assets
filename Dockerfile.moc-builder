# MOC build worker image. Build this image from a checked-out, pinned
# MOC-Core-SDK; the worker never has access to the Warehouse ScanRequest API.
FROM python:3.12-slim

ARG MOC_CORE_ROOT=/opt/moc-core
WORKDIR /app
COPY MOC-Core-SDK /opt/moc-core
COPY scripts/moc_build_worker.py /app/moc_build_worker.py
RUN python -m pip install --no-cache-dir --no-deps /opt/moc-core \
    && python -m pip install --no-cache-dir astropy astropy-healpix mocpy regions numpy

RUN groupadd --gid 10001 atlas \
    && useradd --uid 10001 --gid atlas --no-create-home atlas \
    && mkdir -p /var/lib/assets-evidence \
    && chown -R atlas:atlas /app /var/lib/assets-evidence

ENV PYTHONPATH=/opt/moc-core
USER 10001:10001
ENTRYPOINT ["python", "/app/moc_build_worker.py"]
